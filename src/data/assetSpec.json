{
  "version": 1,
  "conventions": {
    "units": "metres, 1 unit = 1 m",
    "axes": "+Y up, characters face +Z",
    "origin": "on the ground, between the feet",
    "transforms": "applied before export: scale 1, rotation 0",
    "animationFps": 30,
    "textures": "KTX2. UASTC for normal and ORM maps, ETC1S for base colour. 2K per material set; 4K only for a face that earns it; 1K variants for mobile",
    "compression": "Meshopt for skinned and animated meshes (it also compresses keyframes and morph targets). Draco for static environment meshes",
    "audio": "AAC .m4a, 48 kHz masters kept outside the repo. Beds and drones loop seamlessly. Flute stems are delivered DRY (no reverb): the analyser listens to them and the world reverb is added in the mix"
  },

  "templates": {
    "krishna": {
      "requiredBones": [
        "Hips", "Spine", "Chest", "Neck", "Head", "Jaw", "Eye_L", "Eye_R",
        "Shoulder_L", "Shoulder_R", "UpperArm_L", "UpperArm_R", "LowerArm_L", "LowerArm_R", "Hand_L", "Hand_R",
        "Thumb1_L", "Thumb1_R", "Index1_L", "Index1_R", "Middle1_L", "Middle1_R", "Ring1_L", "Ring1_R", "Pinky1_L", "Pinky1_R",
        "UpperLeg_L", "UpperLeg_R", "LowerLeg_L", "LowerLeg_R", "Foot_L", "Foot_R", "Toes_L", "Toes_R"
      ],
      "secondaryBoneChains": { "Feather_": 3, "Dhoti_": 2, "Scarf_": 2, "Hair_": 2, "Mala_": 2 },
      "requiredMeshes": [
        "KR_Body", "KR_Face", "KR_Eyes", "KR_Hair", "KR_Feather", "KR_Cloth_Dhoti", "KR_Cloth_Scarf",
        "KR_Jewelry_Crown", "KR_Jewelry_Necklace", "KR_Flute"
      ],
      "requiredMorphTargets": [
        "eyeBlinkLeft", "eyeBlinkRight", "eyeSquintLeft", "eyeSquintRight", "eyeWideLeft", "eyeWideRight",
        "browInnerUp", "browDownLeft", "browDownRight", "mouthSmileLeft", "mouthSmileRight", "jawOpen", "mouthFunnel", "mouthPucker"
      ],
      "preferredMorphTargets": ["viseme_aa", "viseme_E", "viseme_I", "viseme_O", "viseme_U", "viseme_PP", "viseme_FF"],
      "notes": "Bone and mesh names are identical on Bal and Kishore. The transformation dissolves the character part by part, and the animator retargets by name. Materials are separate for skin, eyes (sclera/iris plus a clear cornea mesh), hair (alpha-hashed cards), cloth, jewellery (metal)."
    }
  },

